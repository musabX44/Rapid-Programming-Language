// std/math.rapid — RapidC "standart kütüphane" örneği.

// Kullanım:
//     use "std/math.rapid";
//     fn main() { io::out(sqrt(2.0)); }
//
// Derleme, projedeki her `link "..."` gerektiren programla birebir aynıdır
// (ekstra bir bayrak/adım YOK — `keyword` derlenirken otomatik `link "m";`
// üretir, `rapidc` de onu görüp `-lm`'i linklemeye zaten kendisi ekliyor):
//     ./rapidc app.rapid -o app
//

// --- Temel: kök, kuvvet, mutlak değer ---
keyword sqrt(x: double): double  => extern "sqrt"  from "m";
keyword cbrt(x: double): double  => extern "cbrt"  from "m";
keyword pow(x: double, y: double): double => extern "pow" from "m";
keyword fabs(x: double): double  => extern "fabs"  from "m";
keyword hypot(x: double, y: double): double => extern "hypot" from "m";

// --- Yuvarlama ---
keyword floor(x: double): double => extern "floor" from "m";
keyword ceil(x: double): double  => extern "ceil"  from "m";
keyword round(x: double): double => extern "round" from "m";
keyword trunc(x: double): double => extern "trunc" from "m";

// --- Trigonometri ---
keyword sin(x: double): double   => extern "sin"   from "m";
keyword cos(x: double): double   => extern "cos"   from "m";
keyword tan(x: double): double   => extern "tan"   from "m";
keyword asin(x: double): double  => extern "asin"  from "m";
keyword acos(x: double): double  => extern "acos"  from "m";
keyword atan(x: double): double  => extern "atan"  from "m";
keyword atan2(y: double, x: double): double => extern "atan2" from "m";

// --- Hiperbolik ---
keyword sinh(x: double): double  => extern "sinh"  from "m";
keyword cosh(x: double): double  => extern "cosh"  from "m";
keyword tanh(x: double): double  => extern "tanh"  from "m";

// --- Üstel / logaritmik ---
keyword exp(x: double): double   => extern "exp"   from "m";
keyword exp2(x: double): double  => extern "exp2"  from "m";
keyword log(x: double): double   => extern "log"   from "m";   // doğal log (ln)
keyword log2(x: double): double  => extern "log2"  from "m";
keyword log10(x: double): double => extern "log10" from "m";

// --- Kalan / işaret ---
keyword fmod(x: double, y: double): double => extern "fmod" from "m";
keyword copysign(x: double, y: double): double => extern "copysign" from "m";
keyword fmin(x: double, y: double): double => extern "fmin" from "m";
keyword fmax(x: double, y: double): double => extern "fmax" from "m";


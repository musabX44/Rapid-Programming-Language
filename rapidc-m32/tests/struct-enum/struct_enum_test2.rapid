struct Point {
    x: int;
    y: int;
}

enum Color { RED = 0, GREEN, BLUE = 5, YELLOW }

fn main() {
    var p: Point;
    p.x = 10;
    p.y = 20;
    io::out(p.x);
    io::out(p.y);
    var c: Color = Color::GREEN;
    io::out(c);
    var q: int* = &p.y;
    io::out(*q);
    *q = 99;
    io::out(p.y);
    return;
}